# name: test_typescript_export
  dict({
    'Address.v1.0.0.ts': '''
      export interface Address {
        street: string;
        city: string;
      }
    ''',
    'Address.v2.0.0.ts': '''
      export interface Address {
        street: string;
        city: string;
        country?: string;
      }
    ''',
    'Address.v3.0.0.ts': '''
      export interface Address {
        street: string;
        city: string;
        country?: string;
        zip_code?: string;
      }
    ''',
    'User.v1.0.0.ts': '''
      export interface User {
        name: string;
        email: string;
        role: 'admin' | 'user' | 'guest';
      }
    ''',
    'User.v2.0.0.ts': '''
      export interface AddressV1 {
        street: string;
        city: string;
      }
      
      
      
      export interface User {
        name: string;
        email: string;
        age?: number;
        role: 'admin' | 'user' | 'guest';
        address: AddressV1;
      }
    ''',
    'User.v3.0.0.ts': '''
      /**
       * Address with zip code.
       */
      export interface AddressV3 {
        street: string;
        city: string;
        country?: string;
        zip_code?: string;
      }
      
      
      
      export interface User {
        name: string;
        email: string;
        age?: number;
        role: 'admin' | 'user' | 'guest';
        status: 'active' | 'inactive';
        address: AddressV3;
      }
    ''',
  })
