# name: test_proto_export
  dict({
    'Address_v1_0_0.proto': '''
      syntax = "proto3";
      
      package com.example;
      
      message Address {
        string street = 1;
        string city = 2;
      }
    ''',
    'Address_v2_0_0.proto': '''
      syntax = "proto3";
      
      package com.example;
      
      message Address {
        string street = 1;
        string city = 2;
        optional string country = 3;
      }
    ''',
    'Address_v3_0_0.proto': '''
      syntax = "proto3";
      
      package com.example;
      
      message Address {
        string street = 1;
        string city = 2;
        optional string country = 3;
        optional string zip_code = 4;
      }
    ''',
    'User_v1_0_0.proto': '''
      syntax = "proto3";
      
      package com.example;
      
      enum Role {
        ADMIN = 0;
        USER = 1;
        GUEST = 2;
      }
      
      message User {
        string name = 1;
        string email = 2;
        Role role = 3;
      }
    ''',
    'User_v2_0_0.proto': '''
      syntax = "proto3";
      
      package com.example;
      
      enum Role {
        ADMIN = 0;
        USER = 1;
        GUEST = 2;
      }
      
      message AddressV1 {
        string street = 1;
        string city = 2;
      }
      message User {
        string name = 1;
        string email = 2;
        optional int32 age = 3;
        Role role = 4;
        AddressV1 address = 5;
      }
    ''',
    'User_v3_0_0.proto': '''
      syntax = "proto3";
      
      package com.example;
      
      enum Role {
        ADMIN = 0;
        USER = 1;
        GUEST = 2;
      }
      
      // Address with zip code.
      message AddressV3 {
        string street = 1;
        string city = 2;
        optional string country = 3;
        optional string zip_code = 4;
      }
      message User {
        string name = 1;
        string email = 2;
        optional uint64 age = 3;
        Role role = 4;
        optional string status = 5;
        AddressV3 address = 6;
      }
    ''',
  })
